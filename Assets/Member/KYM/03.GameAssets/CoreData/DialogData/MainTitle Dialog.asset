    Description: "\uB108\uD55C\uD14C \uBD80\uD0C1\uD560 \uAC83\uC774 \uC788\uB2E4."
  - Id: 1
    SpeakerName: "\uC8FC\uC778\uACF5"
    SpeakeIcon: {fileID: -2311659948842064771, guid: 63f4ca2f9232e7f4f8f5bd38edae35f1, type: 3}
    Description: "\uBB54\uB370\uC694"
  - Id: 0
