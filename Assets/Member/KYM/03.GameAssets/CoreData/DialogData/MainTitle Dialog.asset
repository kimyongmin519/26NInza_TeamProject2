    SpeakeIcon: {fileID: -5676741272876029023, guid: 9aa6959baab5663488ee438b0f38c107, type: 3}
    Description: "\uB0B4\uAC00 \uC7A1\uC544\uC57C\uD560 \uBC94\uC8C4\uC790\uB4E4\uC774
      \uC880 \uC788\uB294\uB370,"
  - Id: 0
    SpeakerName: "\uCD5C\uC2A4\uC2B9"
    SpeakeIcon: {fileID: -5676741272876029023, guid: 9aa6959baab5663488ee438b0f38c107, type: 3}
    Description: "\uAC54\uB4E4 \uC880 \uB300\uC2E0 \uC7A1\uC544\uC918."
  - Id: 1
    SpeakerName: "\uC8FC\uC778\uACF5"
    SpeakeIcon: {fileID: -2311659948842064771, guid: 63f4ca2f9232e7f4f8f5bd38edae35f1, type: 3}
    Description: "<Speed>\uC2EB\uC5B4\uC694.<Speed>"
  - Id: 0
    SpeakerName: "\uCD5C\uC2A4\uC2B9"
    SpeakeIcon: {fileID: -5676741272876029023, guid: 9aa6959baab5663488ee438b0f38c107, type: 3}
    Description: "<Speed>\uC0E4\uAC08.<Speed>"
  - Id: 0
